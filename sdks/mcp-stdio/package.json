{
  "name": "@odudu-io/mcp-stdio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "odudu-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    "./internal": "./src/internal.ts"
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --reporter=default --reporter=json --outputFile=trace-report.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@odudu-io/oidc": "workspace:^",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "9.0.0"
  }
}
