{
  "name": "@odudu-io/next",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wizzywit/odudu.git",
    "directory": "sdks/next"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --reporter=default --reporter=json --outputFile=trace-report.json"
  },
  "dependencies": {
    "@odudu-io/bff": "workspace:^"
  },
  "devDependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  }
}
