# Consumed by infra/docker/compose.yaml. Copy to infra/docker/.env and
# fill in real values before running the stack anywhere but a throwaway
# local machine — these are local-development placeholders, not secrets
# to guard.
POSTGRES_USER=odudu
POSTGRES_PASSWORD=odudu
POSTGRES_DB=odudu
ODUDU_SVC_PASSWORD=odudu_svc
