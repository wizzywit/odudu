# Consumed by infra/docker/compose.yaml. Copy to infra/docker/.env — these
# are local-development placeholders, not secrets to guard.
POSTGRES_USER=odudu
POSTGRES_PASSWORD=odudu
POSTGRES_DB=odudu
ODUDU_SVC_PASSWORD=odudu_svc
# Base64, decodes to exactly 32 bytes. A throwaway dev value — generate a
# real one for anything that isn't this local compose stack.
ODUDU_KEK=KioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKio=

# Host ports the stack publishes on 127.0.0.1. Move them when something
# else already holds 3000 or 5442; ODUDU_PUBLIC_BASE_URL follows the first.
# ODUDU_HOST_PORT=3000
# POSTGRES_HOST_PORT=5442
