{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "vitest.config.ts",
    "tsconfig.base.json",
    "pnpm-lock.yaml",
    "tests/setup/**",
    "eslint.config.js"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tests/**", "drizzle/**", "package.json", "tsconfig.json"],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/sdk-generate#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "requirements.txt",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/sdks/*/src/generated/**",
        "$TURBO_ROOT$/sdks/python/src/**",
        "$TURBO_ROOT$/apps/docs/static/openapi/**"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/mcp#typecheck": {
      "dependsOn": ["^typecheck", "@odudu-io/mcp-stdio#build"]
    },
    "@odudu/mcp-catalogue#typecheck": {
      "dependsOn": ["^typecheck", "@odudu-io/mcp-stdio#build"]
    },
    "@odudu/server#typecheck": {
      "dependsOn": ["^typecheck", "@odudu-io/mcp-stdio#build"]
    },
    "@odudu/mcp#test": {
      "dependsOn": ["^typecheck", "@odudu-io/mcp-stdio#build"],
      "inputs": ["src/**", "tests/**", "drizzle/**", "package.json", "tsconfig.json"],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu-io/mcp-stdio#typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "@odudu-io/mcp-stdio#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.ts"],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/mcp-catalogue#test": {
      "dependsOn": ["^typecheck", "@odudu-io/mcp-stdio#build"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/sdks/mcp-stdio/src/mcp-tools.json"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu-io/bff#typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "@odudu-io/bff#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json"],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu-io/react#typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "@odudu-io/react#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json"],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu-io/next#typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "@odudu-io/next#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json"],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/db#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/*/src/schema/**"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/domain-theme#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/*/src/view/*.ts",
        "$TURBO_ROOT$/packages/kernel/src/password-hints.ts",
        "$TURBO_ROOT$/packages/kernel/src/page.ts",
        "$TURBO_ROOT$/packages/instrument/src/pages.css"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/protocol-oidc#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/*/src/view/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/tests/lint/fixtures/renderer-without-shell/**",
        "$TURBO_ROOT$/tests/lint/fixtures/renderer-without-theme/**"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/server#test": {
      "dependsOn": ["^typecheck", "@odudu-io/mcp-stdio#build"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/console-gateway/tests/fixtures/**",
        "$TURBO_ROOT$/packages/protocol-oidc/src/service/client-assertion.ts"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/console-gateway#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/package.json"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/instrument#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/ui/*.css"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/email#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/ui/tokens.css",
        "$TURBO_ROOT$/packages/instrument/src/mark.svg"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/instrument#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/ui/*.css"
      ],
      "outputs": ["dist/**"]
    },
    "@odudu/docs#build": {
      "dependsOn": [],
      "inputs": [
        "content/**",
        "!content/en/reference/generated/**",
        "src/**",
        "static/**",
        "!static/openapi/**",
        "plugins/**",
        "scripts/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/packages/*/src/**/*.test.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "!$TURBO_ROOT$/apps/server/src/**/*.test.ts",
        "$TURBO_ROOT$/apps/server/package.json",
        "nav.ts",
        "sidebars.ts",
        "seo.ts",
        "site.config.ts",
        "docusaurus.config.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/ui/*.css"
      ],
      "env": ["DOCS_SITE_ORIGIN", "DOCS_BASE", "DOCS_CONTENT", "ODUDU_COMMIT"],
      "outputs": ["dist/**", "content/en/reference/generated/**", "static/openapi/**"]
    },
    "@odudu/docs#test": {
      "dependsOn": ["^typecheck", "@odudu/docs#build"],
      "inputs": [
        "content/**",
        "!content/en/reference/generated/**",
        "src/**",
        "static/**",
        "!static/openapi/**",
        "plugins/**",
        "nav.ts",
        "sidebars.ts",
        "seo.ts",
        "site.config.ts",
        "docusaurus.config.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/src/**",
        "!$TURBO_ROOT$/apps/admin-console/src/**/*.test.ts",
        "!$TURBO_ROOT$/apps/admin-console/src/**/*.test.tsx",
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/packages/*/src/**/*.test.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/examples/README.md",
        "$TURBO_ROOT$/examples/_shared/**",
        "$TURBO_ROOT$/examples/*/README.md",
        "$TURBO_ROOT$/examples/*/package.json",
        "$TURBO_ROOT$/examples/*/test.ts",
        "$TURBO_ROOT$/examples/*/requirements.txt",
        "$TURBO_ROOT$/examples/*/test_example.py",
        "$TURBO_ROOT$/examples/*/*.ts",
        "$TURBO_ROOT$/examples/*/*.py",
        "$TURBO_ROOT$/examples/*/src/*.ts",
        "$TURBO_ROOT$/examples/*/src/*.tsx",
        "$TURBO_ROOT$/examples/*/lib/*.ts",
        "$TURBO_ROOT$/sdks/*/package.json",
        "$TURBO_ROOT$/sdks/*/pyproject.toml",
        "$TURBO_ROOT$/sdks/*/tsup.config.ts",
        "$TURBO_ROOT$/sdks/*/src/index.ts",
        "$TURBO_ROOT$/sdks/*/src/shared.ts",
        "$TURBO_ROOT$/sdks/*/src/adapter/*.ts",
        "$TURBO_ROOT$/sdks/python/src/odudu/**/__init__.py",
        "$TURBO_ROOT$/sdks/python/src/odudu/verify/*.py",
        "$TURBO_ROOT$/sdks/python/src/odudu/_generated/*.py",
        "$TURBO_ROOT$/apps/server/src/**",
        "!$TURBO_ROOT$/apps/server/src/**/*.test.ts",
        "$TURBO_ROOT$/apps/server/package.json",
        "$TURBO_ROOT$/docs/phases/p4g.md",
        "scripts/**",
        "tests/**"
      ],
      "outputs": ["trace-report.json"],
      "env": ["ODUDU_TEST_SHARD"]
    },
    "@odudu/repo-checks#test": {
      "cache": false,
      "dependsOn": ["^typecheck", "@odudu/admin-console#build"],
      "env": ["ODUDU_TEST_SHARD"]
    }
  }
}
