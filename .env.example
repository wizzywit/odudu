NODE_ENV=development
ODUDU_HTTP_HOST=0.0.0.0
ODUDU_HTTP_PORT=3000
# Owner role. Bypasses row-level security (ADR 0009) — used to run
# migrations, never to serve traffic. Required in every environment.
ODUDU_DATABASE_URL=postgres://odudu:odudu@localhost:5432/odudu
# Restricted `odudu_svc` role, subject to FORCE ROW LEVEL SECURITY. The
# server serves traffic on this connection. Required when NODE_ENV=production;
# strongly recommended everywhere else so local development matches
# production isolation instead of running as the RLS-bypassing owner.
ODUDU_APP_DATABASE_URL=postgres://odudu_svc:odudu_svc@localhost:5432/odudu
# Trust X-Forwarded-* headers for request.ip. Only set true behind a
# reverse proxy that overwrites them — otherwise request.ip is
# client-controlled. Defaults to false.
ODUDU_TRUST_PROXY=false
ODUDU_LOG_LEVEL=info
