# Consumed by the server run directly on your host (`pnpm --filter
# @odudu/server dev`, loaded via Node's --env-file-if-exists), as opposed
# to infra/docker/.env.example, which the compose stack reads. Copy to
# `.env` at the repo root.
#
# odudu_svc is provisioned only by the compose stack's initdb
# (infra/docker/initdb/01-app-role.sh) and by the test harness. Pointing
# this at a Postgres you set up by hand needs that role created manually.
# The odudu/odudu and odudu_svc/odudu_svc credentials below must match
# whatever infra/docker/.env actually sets — change one, change both, or
# authentication fails.
NODE_ENV=development
# Loopback for a host run: 0.0.0.0 would publish the dev server to your
# LAN. The container image sets 0.0.0.0 itself, which is where it is needed.
ODUDU_HTTP_HOST=127.0.0.1
ODUDU_HTTP_PORT=3000 # compose also publishes 127.0.0.1:3000:3000; change one if running both at once
# Owner role. Bypasses row-level security (ADR 0009) — used to run
# migrations, never to serve traffic. Required in every environment.
# Port 5442 matches the host port infra/docker/compose.yaml publishes
# Postgres on, not Postgres's default 5432.
ODUDU_DATABASE_URL=postgres://odudu:odudu@localhost:5442/odudu
# Restricted `odudu_svc` role, subject to FORCE ROW LEVEL SECURITY. The
# server serves traffic on this connection. Required when NODE_ENV=production;
# strongly recommended everywhere else so local development matches
# production isolation instead of running as the RLS-bypassing owner.
ODUDU_APP_DATABASE_URL=postgres://odudu_svc:odudu_svc@localhost:5442/odudu
# Trust X-Forwarded-* headers for request.ip. Only set true behind a
# reverse proxy that overwrites them — otherwise request.ip is
# client-controlled. Defaults to false.
ODUDU_TRUST_PROXY=false
ODUDU_LOG_LEVEL=info
