{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "../.dependency-cruiser.cjs"],
  // Parsed by its lint, never compiled: these files import the console's own
  // modules, which resolve only inside apps/admin-console.
  "exclude": [
    "lint/fixtures/console-reads-not-mutations/**",
    "lint/fixtures/console-folder-imports/**",
    "lint/fixtures/console-no-duplicate-exports/**",
    "lint/fixtures/console-no-module-state/**",
    "lint/fixtures/console-store-access/**",
    "lint/fixtures/console-css-module-classes-defined/**",
    "lint/fixtures/console-query-keys/**",
    "lint/fixtures/renderer-without-shell/**",
    "lint/fixtures/renderer-without-theme/**",
    "lint/fixtures/literals/**",
    "lint/fixtures/docs-no-readonly/**",
    "lint/fixtures/docs-service-no-dom/**",
    "boundaries/fixtures/apps/docs/**"
  ]
}
