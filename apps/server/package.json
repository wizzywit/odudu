{
  "name": "@odudu/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "test:plans": "ODUDU_QUERY_PLANS=1 vitest run --config ../../vitest.config.ts --project plans",
    "test": "vitest run --config ../../vitest.config.ts --reporter=default --reporter=json --outputFile=trace-report.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/formbody": "9.0.1",
    "@odudu/account": "workspace:*",
    "@odudu/authn-flows": "workspace:*",
    "@odudu/console-gateway": "workspace:*",
    "@odudu/contracts": "workspace:*",
    "@odudu/crypto": "workspace:*",
    "@odudu/db": "workspace:*",
    "@odudu/domain-audit": "workspace:*",
    "@odudu/domain-authz": "workspace:*",
    "@odudu/domain-identity": "workspace:*",
    "@odudu/domain-tenant": "workspace:*",
    "@odudu/domain-theme": "workspace:*",
    "@odudu/email": "workspace:*",
    "@odudu/i18n": "workspace:*",
    "@odudu/instrument": "workspace:*",
    "@odudu/kernel": "workspace:*",
    "@odudu/protocol-admin": "workspace:*",
    "@odudu/protocol-oidc": "workspace:*",
    "@odudu/web-assets": "workspace:*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@odudu/testkit": "workspace:*",
    "drizzle-orm": "0.45.4",
    "parse5": "8.0.1",
    "tsup": "9.0.0",
    "vitest": "5.0.5"
  }
}
