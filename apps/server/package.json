{
  "name": "@odudu/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@odudu/authn-flows": "workspace:*",
    "@odudu/db": "workspace:*",
    "@odudu/kernel": "workspace:*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
