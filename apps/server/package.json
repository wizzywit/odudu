{
  "name": "@odudu/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@odudu/authn-flows": "workspace:*",
    "@odudu/crypto": "workspace:*",
    "@odudu/db": "workspace:*",
    "@odudu/domain-identity": "workspace:*",
    "@odudu/domain-realm": "workspace:*",
    "@odudu/kernel": "workspace:*",
    "@odudu/protocol-oidc": "workspace:*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@odudu/testkit": "workspace:*",
    "drizzle-orm": "0.45.2",
    "tsup": "8.5.1",
    "vitest": "5.0.0"
  }
}
