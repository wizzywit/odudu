{
  "name": "odudu",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json --noEmit && tsc -p brand/tsconfig.json --noEmit && tsc -p quickstart/tsconfig.json --noEmit",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ODUDU_COMMIT=${ODUDU_COMMIT:-$(git rev-parse --short HEAD)} turbo run test --concurrency=4",
    "test:plans": "pnpm --filter @odudu/server test:plans",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:node-esm": "pnpm --filter @odudu/protocol-admin test:node-esm",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "//trace": "reads every package's trace-report.json, which only `pnpm test` produces \u2014 run that first; strict is the default, so a MUST with no test fails the build",
    "trace": "ODUDU_TRACE_STRICT=1 node tools/trace/src/index.ts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:node-esm && pnpm boundaries && ODUDU_COMMIT=${ODUDU_COMMIT:-$(git rev-parse --short HEAD)} turbo run build && pnpm test && pnpm trace",
    "mutate:crypto": "stryker run packages/crypto/stryker.config.json",
    "conformance:config-op": "bash infra/conformance/run-config-op.sh",
    "conformance:dynamic-op": "bash infra/conformance/run-dynamic-op.sh",
    "docs:screenshots": "pnpm --filter @odudu/docs screenshots",
    "docs:gif": "pnpm --filter @odudu/docs gif"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
