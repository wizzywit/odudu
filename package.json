{
  "name": "odudu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --reporter=default --reporter=json --outputFile=trace-report.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "//trace": "reads trace-report.json, which only `pnpm test` produces — run that first; strict is the default, so a MUST with no test fails the build",
    "trace": "ODUDU_TRACE_STRICT=1 node tools/trace/src/index.ts trace-report.json",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm boundaries && turbo run build && pnpm test && pnpm trace",
    "mutate:crypto": "stryker run packages/crypto/stryker.config.json",
    "conformance:config-op": "bash infra/conformance/run-config-op.sh"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.4",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
