{
  "name": "@odudu/domain-theme",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --reporter=default --reporter=json --outputFile=trace-report.json"
  },
  "dependencies": {
    "@odudu/contracts": "workspace:*",
    "@odudu/db": "workspace:*",
    "@odudu/kernel": "workspace:*",
    "drizzle-orm": "0.45.4",
    "parse5": "8.0.1",
    "postcss": "8.5.31",
    "postcss-value-parser": "4.2.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@odudu/domain-tenant": "workspace:*",
    "@odudu/testkit": "workspace:*",
    "vitest": "5.0.5"
  }
}
