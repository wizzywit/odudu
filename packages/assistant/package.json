{
  "name": "@odudu/assistant",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
