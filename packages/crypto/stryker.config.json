{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "packages/crypto/vitest.config.ts", "related": false },
  "mutate": ["packages/crypto/src/service/**/*.ts", "!packages/crypto/src/**/*.test.ts"],
  "thresholds": { "high": 90, "low": 80, "break": 75 },
  "reporters": ["progress", "clear-text"]
}
