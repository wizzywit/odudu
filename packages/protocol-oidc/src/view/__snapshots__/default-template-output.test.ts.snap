exports[`the account chooser under the default template > renders byte-identically (arabic dark) 1`] = `
"<!doctype html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>اختر حسابًا</title>
<link rel="stylesheet" href="/instrument/instrument.css">
<link rel="icon" href="/instrument/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/instrument/favicon.ico" sizes="48x48">
</head>
<body>
<main class="page">
<p class="brand"><svg class="mark" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="16" cy="6" r="4"/><path d="M16 10V30"/><path d="M12 14H20"/></svg><span class="wordmark">odudu</span></p>
<header class="intro">
<h1>اختر حسابًا</h1>
<p class="tenant"><bdi>t1</bdi></p>
</header>
<form method="post" action="/tenants/t1/login-actions/select-account">
  <input type="hidden" name="auth_session_id" value="sess-1">
  <button type="submit" name="session_id" value="s1" class="secondary choice"><bdi>alice@example.test</bdi></button>
  <button type="submit" name="session_id" value="s&quot;2" class="secondary choice"><bdi>&lt;b&gt;&quot;o&#39;brien&quot;&lt;/b&gt; &amp; co</bdi></button>
  <button type="submit" name="use_other" value="1" class="quiet">استخدام حساب آخر</button>
</form>
</main>
</body>
</html>"
`;

