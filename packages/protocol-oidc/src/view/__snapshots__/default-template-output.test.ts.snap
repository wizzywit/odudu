exports[`the consent page under the default template > renders every option byte-identically 1`] = `
"<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Allow access?</title>
<link rel="stylesheet" href="/instrument/instrument.css">
<link rel="icon" href="/instrument/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/instrument/favicon.ico" sizes="48x48">
</head>
<body>
<main class="page">
<p class="brand"><svg class="mark" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="16" cy="6" r="4"/><path d="M16 10V30"/><path d="M12 14H20"/></svg><span class="wordmark">odudu</span></p>
<header class="intro">
<h1><bdi>&lt;b&gt;&quot;o&#39;brien&quot;&lt;/b&gt; &amp; co</bdi> is asking for access</h1>
<p class="tenant"><bdi>&lt;b&gt;&quot;o&#39;brien&quot;&lt;/b&gt; &amp; co</bdi></p>
</header>
<p><a href="https://rp.test/?a=1&amp;b=2">About <bdi>&lt;b&gt;&quot;o&#39;brien&quot;&lt;/b&gt; &amp; co</bdi></a> · <a href="https://rp.test/privacy">Privacy policy</a> · <a href="https://rp.test/terms">Terms of service</a></p>
<form method="post" action="/tenants/%3Cb%3E%22o&#39;brien%22%3C%2Fb%3E%20%26%20co/login-actions/consent">
  <input type="hidden" name="auth_session_id" value="sess-&lt;1&gt;">
  <ul>
  <li><bdi>openid</bdi></li>
  <li><bdi>Your name</bdi></li>
  <li><bdi>&lt;x&gt;</bdi></li>
  </ul>
  <label><input type="checkbox" name="scope" value="email" checked> <bdi>&lt;b&gt;&quot;o&#39;brien&quot;&lt;/b&gt; &amp; co</bdi></label>
  <label><input type="checkbox" name="scope" value="offline_access"> <bdi>Stay signed in</bdi> — grants ongoing access, even while you are not present</label>
  <label><input type="checkbox" name="scope" value="a&quot;b"> <bdi>a&quot;b</bdi></label>
  <button type="submit" name="decision" value="allow">Allow</button>
  <button type="submit" name="decision" value="deny" class="secondary">Deny</button>
</form>
</main>
</body>
</html>"
`;

