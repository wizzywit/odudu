// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the registration pages under the default template > renders the form byte-identically (arabic dark) 1`] = `
"<!doctype html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>إنشاء حساب</title>
<link rel="stylesheet" href="/instrument/instrument.css">
<link rel="icon" href="/instrument/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/instrument/favicon.ico" sizes="48x48">
</head>
<body>
<main class="page">
<p class="brand"><svg class="mark" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="16" cy="6" r="4"/><path d="M16 10V30"/><path d="M12 14H20"/></svg><span class="wordmark">odudu</span></p>
<header class="intro">
<h1>إنشاء حساب</h1>
<p class="tenant"><bdi>acme</bdi></p>
</header>
<form method="post" action="/tenants/acme/login-actions/registration">
  <label>اسم المستخدم <input type="text" name="username" autocomplete="username"></label>
  <label>البريد الإلكتروني <input type="email" name="email" autocomplete="email"></label>
  <label>كلمة المرور <input type="password" name="password" autocomplete="new-password" id="password" minlength="12" spellcheck="false" autocapitalize="off" autocorrect="off" aria-describedby="password-rules-list"></label>
  <div class="rules hint" id="password-rules" data-min="12" data-summary="استُوفي {met} من أصل {total} من القواعد">
    <p class="rules-head"><span>تتطلب كلمة المرور:</span> <button type="button" class="quiet" hidden aria-controls="password" aria-pressed="false">إظهار كلمة المرور</button> <span role="status"></span></p>
    <ul id="password-rules-list">
      <li data-rule="length">12 من الأحرف على الأقل</li>
      <li>ألا تكون كلمة مرور شائعة</li>
    </ul>
  </div>
  <script nonce="NONCE">(function () {
  var box = document.getElementById('password-rules');
  var field = document.getElementById('password');
  if (!box || !field) return;
  var rows = Array.from(box.querySelectorAll('li[data-rule]'));
  var min = Number(box.getAttribute('data-min'));
  var tests = {
    length: function (v) { return Array.from(v.normalize('NFC')).length >= min; },
    digit: function (v) { return /\\d/u.test(v); },
    uppercase: function (v) { return /[A-Z]/u.test(v); },
    lowercase: function (v) { return /[a-z]/u.test(v); },
    special: function (v) { return /[^A-Za-z0-9]/u.test(v); }
  };
  var status = box.querySelector('[role=status]');
  var timer;
  function check() {
    return rows.filter(function (row) {
      var ok = tests[row.getAttribute('data-rule')](field.value);
      row.setAttribute('data-met', String(ok));
      return ok;
    }).length;
  }
  field.addEventListener('input', function () {
    var met = check();
    clearTimeout(timer);
    timer = setTimeout(function () {
      status.textContent = box.getAttribute('data-summary').replace('{met}', met).replace('{total}', rows.length);
    }, 800);
  });
  check();
  var toggle = box.querySelector('button');
  toggle.hidden = false;
  toggle.addEventListener('click', function () {
    var show = field.type === 'password';
    field.type = show ? 'text' : 'password';
    toggle.setAttribute('aria-pressed', String(show));
  });
})();</script>
  <label>تأكيد كلمة المرور <input type="password" name="password_confirm" id="password-confirm" autocomplete="new-password" spellcheck="false" autocapitalize="off" autocorrect="off"></label>
  <script nonce="NONCE">(function () {
  var first = document.getElementById('password');
  var again = document.getElementById('password-confirm');
  var toggle = document.querySelector('#password-rules button');
  if (!first || !again || !toggle) return;
  toggle.addEventListener('click', function () { again.type = first.type; });
})();</script>
  <button type="submit">إنشاء حساب</button>
</form>
</main>
</body>
</html>"
`;

