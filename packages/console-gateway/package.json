{
  "name": "@odudu/console-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --reporter=default --reporter=json --outputFile=trace-report.json"
  },
  "dependencies": {
    "@odudu/contracts": "workspace:*",
    "@odudu/crypto": "workspace:*",
    "@odudu/db": "workspace:*",
    "@odudu/domain-tenant": "workspace:*",
    "@odudu/kernel": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3"
  },
  "devDependencies": {
    "@odudu/testkit": "workspace:*",
    "vitest": "5.0.0"
  }
}
