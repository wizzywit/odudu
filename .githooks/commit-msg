#!/usr/bin/env bash
# Holds a commit message to the rules in tools/commit-message: brief, and no
# tool-attribution trailer. Installed by `git config core.hooksPath .githooks`
# — see the README. CI runs the same checker over every commit on a branch,
# so a clone without the hook is caught too.
set -euo pipefail

exec node "$(git rev-parse --show-toplevel)/tools/commit-message/src/index.ts" "$1"
